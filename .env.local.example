# Firebase Web app configuration (safe to expose to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# createCheckoutOrder endpoint for the current environment.
NEXT_PUBLIC_ORDER_FUNCTION_URL=

# International format, digits only (for example, 2547XXXXXXXX).
NEXT_PUBLIC_WHATSAPP_NUMBER=2547XXXXXXXX

# Cloud Functions CORS origin. Set this in the Functions environment, not in
# the browser. The value below is for local emulator development only.
WEB_APP_ORIGIN=http://localhost:3000

# Never add these to NEXT_PUBLIC_* variables or deploy them from this file.
# For deployed Functions, store each value with:
#   firebase functions:secrets:set MPESA_CONSUMER_KEY
#   firebase functions:secrets:set MPESA_CONSUMER_SECRET
#   firebase functions:secrets:set MPESA_PASSKEY
#   firebase functions:secrets:set MPESA_SHORTCODE
#   firebase functions:secrets:set MPESA_CALLBACK_URL
# Local Functions emulator secrets belong in functions/.secret.local (ignored).
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
# MPESA_CALLBACK_URL=
